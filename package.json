{
  "name": "ts-sftp",
  "type": "module",
  "version": "0.1.3",
  "description": "An SFTP server for Bun — SSH transport, public key auth, and a pluggable file system.",
  "author": "Chris Breuer <chris@stacksjs.org>",
  "license": "MIT",
  "homepage": "https://github.com/stacksjs/ts-sftp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stacksjs/ts-sftp.git"
  },
  "bugs": {
    "url": "https://github.com/stacksjs/ts-sftp/issues"
  },
  "keywords": [
    "sftp",
    "ssh",
    "server",
    "file-transfer",
    "bun",
    "typescript"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "import": "./dist/*"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ts-sftp": "./dist/bin/cli.js"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "bun --bun build.ts",
    "compile": "bun build ./bin/cli.ts --compile --minify --outfile bin/ts-sftp",
    "compile:all": "bun run compile:linux-x64 && bun run compile:linux-arm64 && bun run compile:windows-x64 && bun run compile:darwin-x64 && bun run compile:darwin-arm64",
    "compile:linux-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-linux-x64 --outfile bin/ts-sftp-linux-x64",
    "compile:linux-arm64": "bun build ./bin/cli.ts --compile --minify --target=bun-linux-arm64 --outfile bin/ts-sftp-linux-arm64",
    "compile:windows-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-windows-x64 --outfile bin/ts-sftp-windows-x64.exe",
    "compile:darwin-x64": "bun build ./bin/cli.ts --compile --minify --target=bun-darwin-x64 --outfile bin/ts-sftp-darwin-x64",
    "compile:darwin-arm64": "bun build ./bin/cli.ts --compile --minify --target=bun-darwin-arm64 --outfile bin/ts-sftp-darwin-arm64",
    "zip": "bun run zip:all",
    "zip:all": "bun run zip:linux-x64 && bun run zip:linux-arm64 && bun run zip:windows-x64 && bun run zip:darwin-x64 && bun run zip:darwin-arm64",
    "zip:linux-x64": "zip -j bin/ts-sftp-linux-x64.zip bin/ts-sftp-linux-x64",
    "zip:linux-arm64": "zip -j bin/ts-sftp-linux-arm64.zip bin/ts-sftp-linux-arm64",
    "zip:windows-x64": "zip -j bin/ts-sftp-windows-x64.zip bin/ts-sftp-windows-x64.exe",
    "zip:darwin-x64": "zip -j bin/ts-sftp-darwin-x64.zip bin/ts-sftp-darwin-x64",
    "zip:darwin-arm64": "zip -j bin/ts-sftp-darwin-arm64.zip bin/ts-sftp-darwin-arm64",
    "fresh": "bunx rimraf node_modules/ bun.lock && bun i",
    "prepublishOnly": "bun --bun run build",
    "test": "bun test",
    "lint": "bunx --bun pickier .",
    "lint:fix": "bunx --bun pickier . --fix",
    "changelog": "bunx logsmith --verbose",
    "changelog:generate": "bunx logsmith --output CHANGELOG.md",
    "release": "bunx --bun bumpx prompt --recursive",
    "release:patch": "bunx --bun bumpx patch --commit --tag --push --yes",
    "release:minor": "bunx --bun bumpx minor --commit --tag --push --yes",
    "postinstall": "bunx git-hooks",
    "dev:docs": "bun --bun bunpress dev docs",
    "build:docs": "bun --bun bunpress build docs",
    "preview:docs": "bun --bun bunpress preview docs",
    "typecheck": "bun --bun tsc --noEmit",
    "format": "bunx --bun pickier . --format",
    "format:fix": "bunx --bun pickier . --format --write"
  },
  "dependencies": {
    "@stacksjs/clapp": "^0.2.13"
  },
  "devDependencies": {
    "better-dx": "^0.2.25"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      },
      "autoRestage": true
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
